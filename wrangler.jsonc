{
        "$schema": "node_modules/wrangler/config-schema.json",
        // Custom worker entry: re-uses the OpenNext fetch handler (generated in
        // .open-next/worker.js) and adds a scheduled handler so the cron triggers
        // below can fire /api/cron/* — this replaces the old vercel.json crons.
        // see https://opennext.js.org/cloudflare/howtos/custom-worker
        "main": "./custom-worker.ts",
        "name": "rk-residency",
        // Preserve runtime vars/secrets set via the dashboard (DATABASE_URL,
        // SITE_URL, CRON_SECRET, ADMIN_SESSION_SECRET...) across deploys. Without
        // this, every `wrangler deploy` (incl. Workers Builds CI) would wipe them
        // and the site would 500 again with missing env vars.
        "keep_vars": true,
        // Run the Worker in the region closest to the Neon Postgres database
        // (us-east-1) instead of always running near the visitor — cuts the
        // per-request DB round-trip latency dramatically.
        "placement": { "mode": "smart" },
        "compatibility_date": "2026-11-19",
        "compatibility_flags": [
                "nodejs_compat",
                "global_fetch_strictly_public"
        ],
        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },
        "services": [
                {
                        // Self-reference service binding, the service name must match the worker name
                        // see https://opennext.js.org/cloudflare/caching
                        "binding": "WORKER_SELF_REFERENCE",
                        "service": "rk-residency"
                }
        ],
        "images": {
                // Enable image optimization
                // see https://opennext.js.org/cloudflare/howtos/image
                "binding": "IMAGES"
        },
        "triggers": {
                // Migrated 1:1 from the deleted vercel.json. The strings MUST stay
                // identical to the keys of CRON_ROUTES in custom-worker.ts.
                "crons": [
                        "30 2 * * *",
                        "40 3 * * *",
                        "0 6 * * *",
                        "0 5 1 * *"
                ]
        }
}
